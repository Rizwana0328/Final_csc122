# tasks/urls.py
from django.urls import path
from .import views
from .views import HomePageView

urlpatterns = [
    path('', views.home_view(), name='home'),
    path('', views.task_list, name='task_list'),
    path('', HomePageView.as_view(), name = 'home'),
    path('', views.TaskListView.as_view(), name='task-list'),             # READ
    path('task/create/', views.TaskCreateView.as_view(), name='task-create'),  # CREATE
    path('task/<int:pk>/update/', views.TaskUpdateView.as_view(), name='task-update'),  # UPDATE
    path('task/<int:pk>/delete/', views.TaskDeleteView.as_view(), name='task-delete'),  # DELETE
]